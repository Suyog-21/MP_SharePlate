# =============================================================================
# SharePlate RAG service configuration template
# Copy this file to `.env` in this same folder, then fill in your real values.
# NEVER commit the real .env file.
# =============================================================================

# --- LLM provider (any OpenAI-compatible /chat/completions API) ---
#
# Works with ANY source LLM:
#
# 1. xAI (Grok):
#    LLM_BASE_URL=https://api.x.ai/v1
#    LLM_API_KEY=xai-your-api-key-here
#    LLM_CHAT_MODEL=grok-2-latest
#
# 2. Groq:
#    LLM_BASE_URL=https://api.groq.com/openai/v1
#    LLM_API_KEY=gsk_your-api-key-here
#    LLM_CHAT_MODEL=openai/gpt-oss-120b
#
# 3. OpenAI:
#    LLM_BASE_URL=https://api.openai.com/v1
#    LLM_API_KEY=sk-your-api-key-here
#    LLM_CHAT_MODEL=gpt-4o-mini
#
# 4. Ollama (Local):
#    LLM_BASE_URL=http://localhost:11434/v1
#    LLM_API_KEY=ollama
#    LLM_CHAT_MODEL=llama3

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=YOUR_API_KEY
LLM_CHAT_MODEL=openai/gpt-oss-120b

# --- MongoDB database (users, NGO applications, sessions) ---
MONGODB_URI=mongodb://127.0.0.1:27017/shareplate_db

# --- MySQL database (food posts / donations) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
DB_NAME=ecorescue_db

# --- RAG service server settings ---
RAG_PORT=8000
# Comma-separated list of allowed frontend origins (CORS)
RAG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
