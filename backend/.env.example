# MySQL Database Configuration (Food Posts/Donations)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_PORT=3306
DB_NAME=ecorescue_db

# MongoDB Database Configuration (Users, Sessions, NGO Verification, OTPs)
MONGODB_URI=mongodb://127.0.0.1:27017/shareplate_db

# Session Secret
SESSION_SECRET=shareplate_super_secure_session_secret_2026

# Server Port
PORT=5000

